        <mxCell id="icbXMKeHpZyXDKQUehko-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;labelPosition=center;verticalLabelPosition=middle;spacingLeft=10;spacingRight=10;" value="- Tehtävänä on kerätä mahdollisimman paljon pisteitä suorittamalla kaikki &amp;lt;&lt;b&gt;state&lt;/b&gt;&amp;gt; sisältämät &amp;lt;action&amp;gt;.&lt;br&gt;&lt;br&gt;- Seuraava &amp;lt;&lt;b&gt;state&lt;/b&gt;&amp;gt; ei voi aloittaa ennen, kuin edellisten kaikki &lt;b&gt;&amp;lt;action&amp;gt;&lt;/b&gt; on tehtynä.&lt;br&gt;&lt;br&gt;- Orchestrator priorisoi &lt;b&gt;&amp;lt;state&amp;gt;&lt;/b&gt;, jonka voi aloittaa ja josta saa eniten pisteitä., tällöin saadaan asioita valmiiksi korkealla prioriteetillä ja uutta &amp;lt;state&amp;gt; ei aloiteta, jos edelliset &amp;lt;state&amp;gt; ovat vielä kesken&lt;br&gt;&lt;br&gt;-&amp;nbsp;" vertex="1">
