        <mxCell id="s2X3stAhmo-E7aXaZO5p-2" parent="1" style="verticalLabelPosition=bottom;aspect=fixed;html=1;shape=mxgraph.salesforce.bots2;fillColor=#f8cecc;strokeColor=#b85450;hachureGap=4;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;fillColor2=#E98AAB;labelPosition=center;align=center;verticalAlign=top;container=0;" value="" vertex="1">
