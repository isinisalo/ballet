        <mxCell id="icbXMKeHpZyXDKQUehko-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;labelPosition=center;verticalLabelPosition=middle;spacingLeft=10;spacingRight=10;" value="- On yksittäinen selkeä toimenpide, jonka AI agentti voi suorittaa&lt;div&gt;- &amp;lt;Action&amp;gt; koostuu &amp;lt;Action Goal / Purpose&amp;gt;, &amp;lt;Validation agent&amp;gt; + &amp;lt;Instruction&amp;gt; + &amp;lt;Skill&amp;gt; ja &amp;lt;Work Agent&amp;gt; + &amp;lt;Instruction&amp;gt; + &amp;lt;Skill&amp;gt;&lt;br&gt;- &amp;lt;Action Goal / Purpose&amp;gt; Pitää huolen siitä, että kun &amp;lt;Work Agent&amp;gt; &amp;lt;Instruction&amp;gt; ja &amp;lt;Skill&amp;gt; muokataan,, niin &amp;lt;Action Goal / Purpose&amp;gt; pitää huolen siitä, että mennään edelleen oikeaan suuntaan.&lt;/div&gt;" vertex="1">
          <mxGeometry height="17.27" width="400" x="1640" y="522.73" as="geometry" />
        </mxCell>
        <mxCell id="icbXMKeHpZyXDKQUehko-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;dashed=1;arcSize=4;opacity=75;strokeWidth=2;labelPosition=center;verticalLabelPosition=top;align=left;verticalAlign=bottom;container=0;" value="Environment Orchestrator" vertex="1">
