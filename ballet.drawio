        <mxCell id="s2X3stAhmo-E7aXaZO5p-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;labelPosition=center;verticalLabelPosition=middle;spacingLeft=10;spacingRight=10;" value="- Tehtävänä on saada kaikki &amp;lt;action&amp;gt; valmiiksi&lt;br&gt;&lt;br&gt;- Jos &amp;lt;action&amp;gt; ei voi suorittaa, agentin täytyy kertoa missä &amp;lt;state&amp;gt; / &amp;lt;action&amp;gt; on puutetta, jotta &amp;lt;State Orchestrator&amp;gt; osaa pyytää korjauksen oikean &amp;lt;state&amp;gt; &amp;lt;Action Orchestrator&amp;gt;." vertex="1">
