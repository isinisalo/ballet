{
  "version": 26,
  "environment": {
    "id": "fixture-environment",
    "name": "Fixture environment",
    "description": "A compact two-State canonical integration fixture.",
    "states": [
      {
        "id": "fixture-prepare",
        "name": "Prepare",
        "description": "Create deterministic local fixture evidence.",
        "order": 1,
        "actions": [
          {
            "id": "fixture-create-evidence",
            "name": "Create evidence",
            "description": "Create one bounded local evidence artifact for later verification.",
            "priority": 1,
            "maxRetries": 1,
            "validation": {
              "agentId": "ballet-action-validation-fixture-create-evidence",
              "skillResources": [
                "fixture-skill"
              ]
            },
            "work": {
              "agentId": "ballet-action-work-fixture-create-evidence",
              "skillResources": [
                "fixture-skill"
              ]
            }
          }
        ]
      },
      {
        "id": "fixture-verify",
        "name": "Verify",
        "description": "Verify artifacts and terminal evidence after preparation is done.",
        "order": 2,
        "actions": [
          {
            "id": "fixture-check-evidence",
            "name": "Check evidence",
            "description": "Validate the prepared artifact and record exact checks.",
            "priority": 1,
            "maxRetries": 0,
            "validation": {
              "agentId": "ballet-action-validation-fixture-check-evidence",
              "skillResources": [
                "fixture-skill"
              ]
            },
            "work": {
              "agentId": "ballet-action-work-fixture-check-evidence",
              "skillResources": [
                "fixture-skill"
              ]
            }
          },
          {
            "id": "fixture-review-evidence",
            "name": "Review run evidence",
            "description": "Verify the terminal projection is factual and complete.",
            "priority": 2,
            "maxRetries": 1,
            "validation": {
              "agentId": "ballet-action-validation-fixture-review-evidence",
              "skillResources": [
                "fixture-skill"
              ]
            },
            "work": {
              "agentId": "ballet-action-work-fixture-review-evidence",
              "skillResources": [
                "fixture-skill"
              ]
            }
          }
        ]
      }
    ]
  },
  "critic": {
    "version": 2,
    "enabled": false,
    "schedules": [
      {
        "id": "fixture-weekly",
        "kind": "weekly",
        "timeZone": "Etc/UTC",
        "localTimes": [
          "09:00"
        ],
        "weekdays": [
          1
        ]
      }
    ],
    "agent": {
      "agentId": "ballet-critic-agent",
      "skillResources": [
        "fixture-skill"
      ]
    }
  },
  "refinement": {
    "version": 2,
    "enabled": true,
    "agent": {
      "agentId": "ballet-refinement-agent",
      "skillResources": [
        "fixture-skill"
      ]
    },
    "allowedRoots": [
      ".codex/agents",
      ".ballet/instructions",
      ".agents/skills"
    ]
  }
}
